{
  "name": "stadiumflow",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "jest --passWithNoTests",
    "test:coverage": "jest --coverage --passWithNoTests",
    "lint": "next lint"
  },
  "dependencies": {
    "@google/generative-ai": "^0.12.0",
    "@googlemaps/js-api-loader": "^1.16.2",
    "@tailwindcss/typography": "^0.5.19",
    "firebase": "^10.12.0",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.8.0",
    "next": "14.2.0",
    "react": "^18",
    "react-dom": "^18",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@types/google.maps": "^3.64.0",
    "@types/googlemaps": "^3.43.3",
    "@types/jest": "^29.5.12",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.19",
    "jest": "^29.7.0",
    "jest-environment-node": "^29.7.0",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.0",
    "ts-jest": "^29.1.4",
    "typescript": "^6.0.2"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "tsconfig": {
            "jsx": "react",
            "esModuleInterop": true
          }
        }
      ]
    },
    "collectCoverageFrom": [
      "src/lib/**/*.ts",
      "src/app/api/**/*.ts"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/.next/"
    ]
  }
}
